      "parameters": {
        "jsCode": "const raw=String($json.text??$json.output??$json.response??'').trim();const original=$('Normalizar consulta Sales').first().json;const ev=$('Preparar evidencia').first().json;const respuesta=ev.encontrado?(raw||'No encuentro esa información en las políticas disponibles'):'No encuentro esa información en las políticas disponibles';return [{json:{status:'success',worker:'SALES',respuesta,requires_human:false,original_input:original.original_input??original.pregunta,rag_found:ev.encontrado,rag_sources:ev.chunks.map(c=>c.fuente)}}];"
