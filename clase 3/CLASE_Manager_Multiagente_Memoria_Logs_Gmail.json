        "jsCode": "const base=$('Actualizar contador de mensajes').first().json;\nconst raw=$json.text??$json.output??$json.response??'';\nlet d;try{d=JSON.parse(String(raw).replace(/^```(?:json)?\\s*/i,'').replace(/```$/,'').trim());}catch(e){d={asunto_principal:base.intent,puntos_clave:[base.historial_pendiente],accion_requerida:'',estado_caso:base.estado_caso};}\nreturn [{json:{...base,resumen_consolidado:[d.asunto_principal,...(Array.isArray(d.puntos_clave)?d.puntos_clave:[]),d.accion_requerida].filter(Boolean).join(' | '),\ndatos_clave:JSON.stringify({puntos_clave:d.puntos_clave??[],accion_requerida:d.accion_requerida??''}),\nestado_caso:d.estado_caso||base.estado_caso||'EN_PROCESO',historial_pendiente:'',mensajes_desde_resumen:0,\nfecha_actualizacion:new Date().toLocaleString('sv-SE',{timeZone:'America/Argentina/Buenos_Aires'})}}];"
      },
