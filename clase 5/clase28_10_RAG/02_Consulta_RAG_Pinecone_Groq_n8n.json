      ],
      "parameters": {
        "promptType": "define",
        "text": "=Respondé exclusivamente con la evidencia recuperada. Si no hay evidencia suficiente, decí 'No encuentro esa información en las políticas disponibles'. No inventes condiciones. Incluí la fuente documental.\\nPREGUNTA: {{ $json.pregunta }}\\nEVIDENCIA: {{ $json.contexto || 'Sin resultados' }}"
      }
