    {
      "parameters": {
        "promptType": "define",
        "text": "=Sos el Router de una mesa de ayuda empresarial.\n\nMensaje:\n{{ $json.original_input }}\n\nTu única tarea es clasificar. NO resuelvas el problema.\n\nIntent permitidos:\n- BILLING: cobros, pagos, facturas, suscripciones.\n- TECH_SUPPORT: acceso, errores, funcionamiento técnico.\n- SALES: planes, contratación, interés comercial.\n- UNKNOWN: ambiguo o fuera de alcance.\n\nRisk:\n- LOW: consulta informativa o diagnóstico seguro.\n- MEDIUM: podría implicar modificación o comunicación externa.\n- HIGH: dinero/reembolso de monto importante, eliminación, cambio irreversible o acción sensible.\n\nConfidence: número entre 0 y 1 sobre la clasificación.\n\nRespondé SOLO JSON válido:\n{\n  \"intent\": \"BILLING\",\n  \"confidence\": 0.95,\n  \"risk\": \"LOW\"\n}"
      },
      "id": "6f2db9d4-6556-4ae7-95a8-fe8374bff427",
      "name": "Router IA - Groq",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        -470,
        0
      ]
    },
    {
      "parameters": {
        "model": "llama-3.1-8b-instant",
        "options": {
          "temperature": 0
        }
      },
      "id": "741baf38-2e42-4291-b107-ab49c6aba852",
      "name": "Modelo Router Groq",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        -470,
        220
      ]
    },
    {
      "parameters": {
        "jsCode": "const original = $('Input de prueba').first().json.original_input;\nconst raw = $json.text ?? $json.output ?? $json.response ?? '';\nlet d;\ntry {\n  d = JSON.parse(String(raw).replace(/^```json\\s*/i,'').replace(/```$/,'').trim());\n} catch (e) {\n  d = { intent:'UNKNOWN', confidence:0, risk:'HIGH' };\n}\nconst allowed = ['BILLING','TECH_SUPPORT','SALES','UNKNOWN'];\nconst intent = allowed.includes(d.intent) ? d.intent : 'UNKNOWN';\nconst confidence = Math.max(0, Math.min(1, Number(d.confidence ?? 0)));\nconst risk = ['LOW','MEDIUM','HIGH'].includes(d.risk) ? d.risk : 'HIGH';\nreturn [{json:{original_input:original,intent,confidence,risk}}];"
      },
