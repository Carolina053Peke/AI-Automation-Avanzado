        "message": "=<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto\"><div style=\"background:#c0392b;padding:16px;border-radius:8px 8px 0 0\"><h2 style=\"color:white;margin:0\">🚨 SOLICITUD DE DERIVACIÓN URGENTE</h2></div><div style=\"background:#f9f9f9;padding:24px;border:1px solid #ddd;border-top:none;border-radius:0 0 8px 8px\"><p><strong>Síntoma principal:</strong><br>{{ $json.triage.sintoma_principal }}</p><p><strong>Nivel de gravedad:</strong> <span style=\"color:#c0392b;font-weight:bold\">{{ $json.triage.nivel_gravedad }}</span></p><p>Por favor tomá una decisión:</p><a href=\"{{ $execution.resumeUrl + '&decision=approve' }}\" style=\"display:inline-block;background:#27ae60;color:white;padding:14px 28px;text-decoration:none;border-radius:6px;font-weight:bold;margin-right:12px\">✅ APROBAR DERIVACIÓN</a><a href=\"{{ $execution.resumeUrl + '&decision=reject' }}\" style=\"display:inline-block;background:#e74c3c;color:white;padding:14px 28px;text-decoration:none;border-radius:6px;font-weight:bold\">❌ RECHAZAR DERIVACIÓN</a><p style=\"margin:24px 0 0;color:#888;font-size:12px\">⚠️ Este enlace es de un solo uso.</p></div></div>",
