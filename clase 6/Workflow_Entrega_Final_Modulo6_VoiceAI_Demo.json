      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        -380,
        100
      ],
      "id": "931c8894-02d2-4d8d-b9af-46a1954537d4",
      "name": "IF - Transcripcion valida?"
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger - Voz').first().json.message.chat.id }}",
        "text": "No pude escuchar tu mensaje de voz con claridad. Por favor, intentá enviarlo nuevamente.",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        -130,
        -80
      ],
      "id": "dda472b1-16c9-45a0-b64a-69eaae3222ec",
      "name": "Telegram - Contingencia"
    },
    {
      "parameters": {
        "text": "={{ $('Groq Whisper - STT').first().json.text }}",
        "options": {
          "systemMessage": "Sos un asistente conversacional de soporte.\nRespondé en español de forma clara, natural y directa.\nTu respuesta será convertida a audio.\n\nREGLAS OBLIGATORIAS:\n- Máximo 200 caracteres por respuesta.\n- Usá frases cortas.\n- No uses markdown.\n- No incluyas URLs.\n- No uses emojis.\n- No inventes información.\n- Si no comprendés la solicitud, pedí una aclaración breve."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1,
      "position": [
        -100,
        180
      ],
      "id": "20b82085-9213-4768-b667-c76ac8b69f62",
      "name": "AI Agent - Cerebro"
    },
    {
      "parameters": {
        "model": "openai/gpt-oss-20b",
        "options": {
          "maxTokensToSample": 300
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        -180,
        430
      ],
      "id": "e0a566f2-d384-4f63-acc5-f83580565aa1",
      "name": "Groq Chat Model"
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ 'cliente_' + String($('Telegram Trigger - Voz').first().json.message.from.id) }}",
        "contextWindowLength": 5
      },
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        40,
        430
      ],
      "id": "44e31926-3c1f-4e5c-8275-14849c183496",
      "name": "Simple Memory"
    },
    {
      "parameters": {
        "jsCode": "// Segunda barrera: aunque el prompt falle, nunca mandamos más de 200 caracteres a TTS\nconst raw = $json.output || '';\nconst text = raw.substring(0, 200).trim();\n\nreturn [{\n  json: {\n    text_response: text,\n    char_count: text.length,\n    chat_id: $('Telegram Trigger - Voz').first().json.message.chat.id\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        180
      ],
      "id": "06e75781-ff89-4945-8414-f409d7cb3d39",
      "name": "Truncado defensivo - 200 chars"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.elevenlabs.io/v1/text-to-speech/REEMPLAZAR_VOICE_ID",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "audio/mpeg"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ text: $json.text_response, model_id: 'eleven_multilingual_v2', voice_settings: { stability: 0.5, similarity_boost: 0.75 } }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
