      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        260
      ],
      "parameters": {
        "jsCode": "const rows=$input.all().map(x=>x.json);const pregunta=$('Pregunta de prueba').first().json.pregunta;const chunks=rows.map((r,i)=>({n:i+1,texto:String(r.pageContent??r.text??r.document?.pageContent??r.metadata?.text??''),fuente:r.metadata?.source??r.document?.metadata?.source??'Documento NovaSaaS',score:r.score??null})).filter(x=>x.texto.trim());return [{json:{pregunta,chunks,contexto:chunks.map(c=>`[Fuente ${c.n}: ${c.fuente}]\\n${c.texto}`).join('\\n\\n'),encontrado:chunks.length>0}}];"
      }
    },
    {
      "id": "cc604500-fff2-4dbe-9f00-9dba55d372ca",
      "name": "Respuesta RAG - Groq",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
