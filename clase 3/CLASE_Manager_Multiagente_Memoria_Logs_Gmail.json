        "jsCode": "const source=$('Preparar contexto de memoria').first().json;\nconst raw=$json.text ?? $json.output ?? $json.response ?? '';\nlet d; try{d=JSON.parse(String(raw).replace(/^```json\\s*/i,'').replace(/```$/,'').trim());}catch(e){d={intent:'UNKNOWN',confidence:0,risk:'HIGH'};}\nconst allowed=['BILLING','TECH_SUPPORT','SALES','UNKNOWN'];\nreturn [{json:{...source,intent:allowed.includes(d.intent)?d.intent:'UNKNOWN',confidence:Math.max(0,Math.min(1,Number(d.confidence??0))),risk:['LOW','MEDIUM','HIGH'].includes(d.risk)?d.risk:'HIGH'}}];"
