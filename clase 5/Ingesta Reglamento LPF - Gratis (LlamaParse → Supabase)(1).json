      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (!items.length) {\n  throw new Error('No llegó ningún archivo. Abrí el formulario del nodo \"Subir Markdown\" y subí el .md desde tu PC.');\n}\n\nconst item = items[0];\nconst binaryKeys = Object.keys(item.binary || {});\n\nif (!binaryKeys.length) {\n  throw new Error('El formulario no trajo archivo. Elegí reglamento-lpf-2025.md antes de enviar.');\n}\n\nconst binaryKey = binaryKeys[0];\nconst buffer = await this.helpers.getBinaryDataBuffer(0, binaryKey);\nconst text = buffer.toString('utf8');\n\nif (!text.trim()) {\n  throw new Error('El archivo markdown está vacío.');\n}\n\nreturn [{\n  json: {\n    source: 'Reglamento-General-LPF-2025.pdf'\n  },\n  binary: {\n    data: await this.helpers.prepareBinaryData(\n      buffer,\n      'reglamento-lpf-2025.md',\n      'text/markdown'\n    )\n  }\n}];"
      },
